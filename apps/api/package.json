{
  "name": "@picky/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "db:migrate": "bun scripts/migrate.ts",
    "build:vercel": "bun build src/vercel-app.ts --target bun --outdir dist --splitting --external onnxruntime-node --external @huggingface/transformers",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@picky/catalog": "workspace:*",
    "@huggingface/transformers": "^4.3.0",
    "hono": "^4.13.13",
    "onnxruntime-node": "^1.30.0",
    "zod": "^4.6.5"
  }
}
