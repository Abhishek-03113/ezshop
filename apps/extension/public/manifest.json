{
  "manifest_version": 3,
  "name": "ezshop capture",
  "version": "0.3.0",
  "description": "Sends the product page you are viewing (Amazon.in, Flipkart) to ezshop as a clean spec sheet.",
  "action": {
    "default_title": "Quick Look: specs of this page"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "offscreen"],
  "host_permissions": ["https://www.amazon.in/*", "https://www.flipkart.com/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Quick Look: specs of this page"
    },
    "open-comparison": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Quick Look: compare this page"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.amazon.in/*", "https://www.flipkart.com/*"],
      "js": ["link-alt-click.js"],
      "run_at": "document_idle"
    }
  ]
}
