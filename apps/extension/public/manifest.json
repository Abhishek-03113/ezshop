{
  "manifest_version": 3,
  "name": "ezshop capture",
  "version": "0.2.0",
  "description": "Sends the product page you are viewing (Amazon.in, Flipkart) to ezshop as a clean spec sheet.",
  "action": {
    "default_title": "Send this product to ezshop"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Send this product to ezshop"
    }
  }
}
